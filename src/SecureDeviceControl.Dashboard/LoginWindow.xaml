<Window x:Class="SecureDeviceControl.Dashboard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot Dashboard - Sign in"
        Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0f172a">
    <Grid Margin="36,24">
        <StackPanel>
            <TextBlock Text="Snapshot Dashboard" FontSize="22" FontWeight="Bold" Foreground="#f1f5f9"/>
            <TextBlock x:Name="SubtitleText" Text="Sign in to review captured screenshots" Foreground="#94a3b8" Margin="0,4,0,0"/>

            <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                <TextBlock Text="FIRST RUN - create your admin login" Style="{StaticResource FieldLabel}" FontWeight="Bold" Foreground="#fbbf24"/>
            </StackPanel>

            <TextBlock Text="Admin ID" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldPassword}"/>

            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FieldPassword}"/>
            </StackPanel>

            <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed">
                <TextBlock Text="Supabase project URL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SupabaseUrlBox" Style="{StaticResource FieldBox}"/>
                <TextBlock Text="Supabase service role key (stays encrypted on this PC)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ServiceKeyBox" Style="{StaticResource FieldBox}"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#f87171" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <Button x:Name="ActionButton" Content="Sign in" Style="{StaticResource DarkButton}"
                    Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="OnActionClicked"/>
        </StackPanel>
    </Grid>
</Window>
