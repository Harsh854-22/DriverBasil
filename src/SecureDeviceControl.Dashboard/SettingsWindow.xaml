<Window x:Class="SecureDeviceControl.Dashboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard settings"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0f172a">
    <Grid Margin="28,20">
        <StackPanel>
            <TextBlock Text="Supabase connection" FontSize="16" FontWeight="Bold" Foreground="#f1f5f9"/>

            <TextBlock Text="Supabase project URL" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SupabaseUrlBox" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="Supabase service role key" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ServiceKeyBox" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="Similarity threshold (higher merges more aggressively, 0-20)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ThresholdBox" Style="{StaticResource FieldBox}"/>

            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save" Style="{StaticResource DarkButton}" Click="OnSaveClicked"/>
                <Button Content="Cancel" Style="{StaticResource DarkButton}" Background="#334155" Margin="8,0,0,0" Click="OnCancelClicked"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
