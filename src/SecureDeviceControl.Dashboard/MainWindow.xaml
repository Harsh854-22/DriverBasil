<Window x:Class="SecureDeviceControl.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot Dashboard"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1e293b" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Snapshot Dashboard" FontSize="16" FontWeight="Bold" Foreground="#f1f5f9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DeviceCountText" Foreground="#64748b" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RefreshDevicesButton" Content="Refresh devices" Style="{StaticResource DarkButton}" Background="#334155" Click="OnRefreshDevicesClicked"/>
                    <Button Content="Settings" Style="{StaticResource DarkButton}" Background="#334155" Margin="8,0,0,0" Click="OnSettingsClicked"/>
                    <Button Content="Logout" Style="{StaticResource DarkButton}" Background="#7f1d1d" Margin="8,0,0,0" Click="OnLogoutClicked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#111c30" Padding="14,10" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Device" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DeviceCombo" Width="320" VerticalContentAlignment="Center"/>
                <TextBlock Text="Date" Foreground="#94a3b8" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker x:Name="DayPicker" VerticalContentAlignment="Center"/>
                <Button x:Name="LoadButton" Content="Load snapshots" Style="{StaticResource DarkButton}" Margin="16,0,0,0" Click="OnLoadClicked"/>
                <TextBlock x:Name="StatusText" Foreground="#94a3b8" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#1e293b" Padding="14,6">
            <TextBlock x:Name="SummaryText" Foreground="#94a3b8" FontSize="12"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
            <ItemsControl x:Name="SessionItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1e293b" CornerRadius="8" Margin="0,0,14,14" Padding="10"
                                Cursor="Hand" MouseLeftButtonUp="OnSessionCardClicked" Tag="{Binding}">
                            <StackPanel Width="280">
                                <Image Source="{Binding Thumbnail}" Height="170" Stretch="Uniform" StretchDirection="Both"/>
                                <TextBlock Text="{Binding TimeRangeText}" Foreground="#f1f5f9" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding FrameCountText}" Foreground="#94a3b8" FontSize="12"/>
                                <TextBlock Text="{Binding DeviceText}" Foreground="#64748b" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
